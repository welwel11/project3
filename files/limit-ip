#!/bin/bash
# Script Limitasi Multi Login (Support Ubuntu 22+)
set -euo pipefail

# ──────────────────────────────
# Fungsi Cek Limit VMESS
# ──────────────────────────────
vmip() {
    : > /var/log/xray/access.log
    sleep 1
    local data=($(ls /etc/kyt/limit/vmess/ip))
    for user in "${data[@]}"; do
        iplimit=$(< /etc/kyt/limit/vmess/ip/$user)
        ehh=$(grep "$user" /var/log/xray/access.log | awk '{print $3}' | sed 's/tcp:\/\///' | cut -d ":" -f1 | sort -u)
        cekcek=$(echo -e "$ehh" | wc -l)
        if [[ $cekcek -gt $iplimit ]]; then
            exp=$(awk -v u="$user" '$2==u {print $3}' /etc/xray/config.json | sort -u)
            sed -i "/^### $user $exp/,/^},{/d" /etc/xray/config.json
            sed -i "/^### $user $exp/d" /etc/vmess/.vmess.db
            systemctl restart xray >/dev/null 2>&1
            rm -f /etc/kyt/limit/vmess/ip/$user
        fi
        sleep 0.1
    done
}

