# ──────────────────────────────
# Main
# ──────────────────────────────
case "${1:-}" in
    vmip) vmip ;;
    vlip) vlip ;;
    trip) trip ;;
    *) echo "Usage: $0 {vmip|vlip|trip}" ;;
esac