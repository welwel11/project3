#!/bin/bash
# Script Limit Trojan (Ubuntu 22+ Compatible)
# Auto remove user yang melewati kuota
# Telegram log dihapus

# Konversi bytes → format lebih mudah dibaca
function con() {
    local -i bytes=$1
    if [[ $bytes -lt 1024 ]]; then
        echo "${bytes}B"
    elif [[ $bytes -lt 1048576 ]]; then
        echo "$(( (bytes + 1023)/1024 ))KB"
    elif [[ $bytes -lt 1073741824 ]]; then
        echo "$(( (bytes + 1048575)/1048576 ))MB"
    else
        echo "$(( (bytes + 1073741823)/1073741824 ))GB"
    fi
}

# Pastikan direktori ada (supaya tidak error)
mkdir -p /etc/limit/trojan
mkdir -p /etc/limit/trojan/quota
mkdir -p /etc/limit/trojan/ip
mkdir -p /etc/trojan
mkdir -p /var/www/html

while true; do
    sleep 30
    # Ambil semua user dari config.json
    data=( $(grep '^#!' /etc/xray/config.json | cut -d ' ' -f 2 | sort | uniq) )

    # Loop per user untuk update traffic
    for user in "${data[@]}"; do
        downlink=$(xray api stats --server=127.0.0.1:10000 \
                   -name "user>>>${user}>>>traffic>>>downlink" 2>/dev/null \
                   | grep -w "value" | awk '{print $2}' | cut -d '"' -f2)

        if [[ -n $downlink ]]; then
            if [[ -e /etc/limit/trojan/${user} ]]; then
                prev=$(cat /etc/limit/trojan/${user})
                total=$(( downlink + prev ))
                echo "$total" > /etc/limit/trojan/${user}
            else
                echo "$downlink" > /etc/limit/trojan/${user}
            fi
            # Reset counter Xray agar akumulasi jalan
            xray api stats --server=127.0.0.1:10000 \
                -name "user>>>${user}>>>traffic>>>downlink" -reset >/dev/null 2>&1
        fi
    done

    # Cek limit quota tiap user
    for user in "${data[@]}"; do
        if [[ -e /etc/trojan/${user} ]]; then
            limit=$(cat /etc/trojan/${user})
            usage=$(cat /etc/limit/trojan/${user} 2>/dev/null)

            if [[ -n $usage && $usage -gt $limit ]]; then
                exp=$(grep -w "^#! $user" "/etc/xray/config.json" \
                      | cut -d ' ' -f 3 | sort | uniq)

                # Hapus user dari config.json & database
                sed -i "/^#! $user $exp/,/^},{/d" /etc/xray/config.json
                sed -i "/^#! $user $exp/d" /etc/trojan/.trojan.db

                # Bersihkan semua file user
                rm -f /etc/limit/trojan/$user
                rm -f /etc/limit/trojan/quota/$user
                rm -f /etc/limit/trojan/ip/$user
                rm -f /etc/trojan/$user
                rm -f /var/www/html/trojan-$user.txt

                # Restart Xray supaya perubahan aktif
                systemctl restart xray >/dev/null 2>&1
            fi
        fi
    done
done