#!/bin/bash
# Auto Limit Quota Shadowsocks (Ubuntu 22+ Support)
# Telegram notification sudah dihapus

function con() {
    local -i bytes=$1
    if [[ $bytes -lt 1024 ]]; then
        echo "${bytes}B"
    elif [[ $bytes -lt 1048576 ]]; then
        echo "$(( (bytes + 1023)/1024 ))KB"
    elif [[ $bytes -lt 1073741824 ]]; then
        echo "$(( (bytes + 1048575)/1048576 ))MB"
    else
        echo "$(( (bytes + 1073741823)/1073741824 ))GB"
    fi
}

while true; do
    sleep 30
    data=($(grep '^###' /etc/shadowsocks/.shadowsocks.db | cut -d ' ' -f 2 | sort | uniq))

    [[ ! -d /etc/limit/shadowsocks ]] && mkdir -p /etc/limit/shadowsocks

    for user in "${data[@]}"; do
        tmpfile="/tmp/${user}"
        xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" >& "$tmpfile"
        getThis=$(awk '{print $1}' "$tmpfile")

        if [[ $getThis != "failed" ]]; then
            downlink=$(grep -w "value" "$tmpfile" | awk '{print $2}' | tr -d '",')

            if [[ -e /etc/limit/shadowsocks/${user} ]]; then
                plus2=$(cat /etc/limit/shadowsocks/${user})
                if [[ -n $plus2 ]]; then
                    plus3=$(( downlink + plus2 ))
                    echo "$plus3" > /etc/limit/shadowsocks/${user}
                else
                    echo "$downlink" > /etc/limit/shadowsocks/${user}
                fi
            else
                echo "$downlink" > /etc/limit/shadowsocks/${user}
            fi

            # reset traffic counter
            xray api stats --server=127.0.0.1:10000 \
              -name "user>>>${user}>>>traffic>>>downlink" -reset >/dev/null 2>&1
        fi
    done

    # Cek quota limit
    for user in "${data[@]}"; do
        if [[ -e /etc/shadowsocks/${user} ]]; then
            checkLimit=$(cat /etc/shadowsocks/${user})
            if [[ -n $checkLimit ]]; then
                if [[ -e /etc/limit/shadowsocks/${user} ]]; then
                    Usage=$(cat /etc/limit/shadowsocks/${user})
                    if [[ $Usage -gt $checkLimit ]]; then
                        exp=$(grep -w "^### $user" /etc/shadowsocks/.shadowsocks.db | awk '{print $3}')

                        # hapus user dari config
                        sed -i "/^#!# $user $exp/,/^},{/d" /etc/xray/config.json
                        sed -i "/^### $user $exp/d" /etc/shadowsocks/.shadowsocks.db

                        # bersihkan file terkait
                        rm -f /etc/shadowsocks/$user
                        rm -f /etc/funny/limit/shadowsocks/ip/${user}
                        rm -f /etc/limit/shadowsocks/$user
                        rm -f /etc/limit/shadowsocks/quota/$user
                        rm -f /var/www/html/sodosokws-$user.txt

                        systemctl restart xray >/dev/null 2>&1
                        echo "[INFO] User $user dihapus karena quota habis"
                    fi
                fi
            fi
        fi
    done
done