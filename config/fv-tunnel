#!/bin/bash
# Script pemasangan layanan limit (diperbaiki untuk Ubuntu 22+)
set -euo pipefail

REPO="https://raw.githubusercontent.com/welwel11/project3/main/"

# === Pastikan direktori ada ===
install -d -m 755 /etc/systemd/system
install -d -m 755 /etc/xray
install -d -m 755 /usr/bin

# === Ambil unit service ===
for svc in vmess vless trojan shadowsocks; do
    wget -q -O "/etc/systemd/system/limit${svc}.service" \
        "${REPO}files/limit${svc}.service"
    chmod 0644 "/etc/systemd/system/limit${svc}.service"
done

# === Ambil script limit ke /etc/xray ===
for scr in vmess vless trojan shadowsocks; do
    wget -q -O "/etc/xray/limit.${scr}" "${REPO}files/${scr}"
    chmod +x "/etc/xray/limit.${scr}" || true
done

# === Reload systemd dan aktifkan service limit utama ===
systemctl daemon-reload
for svc in vmess vless trojan shadowsocks; do
    systemctl enable --now "limit${svc}.service" || true
done

# === Ambil script limit-ip ===
wget -q -O /usr/bin/limit-ip "${REPO}files/limit-ip"
chmod +x /usr/bin/limit-ip
sed -i 's/\r$//' /usr/bin/limit-ip || true

# === Buat service untuk IP Limit ===
cat >/etc/systemd/system/vmip.service <<'EOF'
[Unit]
Description=VMESS IP Limit Service
After=network.target

[Service]
ExecStart=/usr/bin/limit-ip vmip
Restart=always
WorkingDirectory=/root

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/vlip.service <<'EOF'
[Unit]
Description=VLESS IP Limit Service
After=network.target

[Service]
ExecStart=/usr/bin/limit-ip vlip
Restart=always
WorkingDirectory=/root

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/trip.service <<'EOF'
[Unit]
Description=TROJAN IP Limit Service
After=network.target

[Service]
ExecStart=/usr/bin/limit-ip trip
Restart=always
WorkingDirectory=/root

[Install]
WantedBy=multi-user.target
EOF

# === Reload & enable semua ===
systemctl daemon-reload
for svc in vmip vlip trip; do
    systemctl enable --now "$svc.service" || true
done

# === Bersihkan ===
rm -rf /root/fv-tunnel || true

echo "✅ Instalasi selesai!"
echo "Cek status service dengan:"
echo "  systemctl status limitvmess limitvless limittrojan limitshadowsocks vmip vlip trip"