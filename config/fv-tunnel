#!/bin/bash

# Script pemasangan layanan limit (diperbaiki untuk Ubuntu 22+)
set -euo pipefail

REPO="https://raw.githubusercontent.com/welwel11/project3/main/"

# pastikan direktori tujuan ada
mkdir -p /etc/systemd/system
mkdir -p /etc/xray
mkdir -p /usr/bin

# ambil service unit & file limit, lalu atur permission secara spesifik
wget -q -O /etc/systemd/system/limitvmess.service "${REPO}files/limitvmess.service"
wget -q -O /etc/systemd/system/limitvless.service "${REPO}files/limitvless.service"
wget -q -O /etc/systemd/system/limittrojan.service "${REPO}files/limittrojan.service"
wget -q -O /etc/systemd/system/limitshadowsocks.service "${REPO}files/limitshadowsocks.service"

# chmod untuk unit file tidak perlu executable tapi aman tetap 0644
chmod 0644 /etc/systemd/system/limitvmess.service
chmod 0644 /etc/systemd/system/limitvless.service
chmod 0644 /etc/systemd/system/limittrojan.service
chmod 0644 /etc/systemd/system/limitshadowsocks.service

# ambil skrip limit kedalam /etc/xray
wget -q -O /etc/xray/limit.vmess "${REPO}files/vmess"
wget -q -O /etc/xray/limit.vless "${REPO}files/vless"
wget -q -O /etc/xray/limit.trojan "${REPO}files/trojan"
wget -q -O /etc/xray/limit.shadowsocks "${REPO}files/shadowsocks"

# pastikan ada permission executable untuk skrip yang memang dieksekusi
chmod +x /etc/xray/limit.vmess || true
chmod +x /etc/xray/limit.vless || true
chmod +x /etc/xray/limit.trojan || true
chmod +x /etc/xray/limit.shadowsocks || true

# reload systemd dan enable service unit yang baru
systemctl daemon-reload
systemctl enable --now limitvmess.service || true
systemctl enable --now limitvless.service || true
systemctl enable --now limittrojan.service || true
systemctl enable --now limitshadowsocks.service || true

# ambil skrip limit-ip ke /usr/bin dengan nama yang jelas, jangan chmod semua /usr/bin/*
wget -q -O /usr/bin/limit-ip "${REPO}files/limit-ip"
chmod +x /usr/bin/limit-ip

# bersihkan CRLF jika ada
if command -v sed >/dev/null 2>&1; then
  sed -i 's/\r$//' /usr/bin/limit-ip || true
fi

# bikin service khusus yang menjalankan /usr/bin/limit-ip dengan argumen berbeda
cat >/etc/systemd/system/vmip.service <<'EOF'
[Unit]
Description=VMESS IP Limit Service
After=network.target

[Service]
WorkingDirectory=/root
ExecStart=/usr/bin/limit-ip vmip
Restart=always

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/vlip.service <<'EOF'
[Unit]
Description=VLESS IP Limit Service
After=network.target

[Service]
WorkingDirectory=/root
ExecStart=/usr/bin/limit-ip vlip
Restart=always

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/trip.service <<'EOF'
[Unit]
Description=TROJAN IP Limit Service
After=network.target

[Service]
WorkingDirectory=/root
ExecStart=/usr/bin/limit-ip trip
Restart=always

[Install]
WantedBy=multi-user.target
EOF

# reload daemon, restart & enable services safely
systemctl daemon-reload

# use systemctl try-restart/enable to avoid failing the script if not available
systemctl restart vmip.service 2>/dev/null || true
systemctl enable vmip.service 2>/dev/null || true

systemctl restart vlip.service 2>/dev/null || true
systemctl enable vlip.service 2>/dev/null || true

systemctl restart trip.service 2>/dev/null || true
systemctl enable trip.service 2>/dev/null || true

# hapus folder instal sementara (jika ada)
rm -rf /root/fv-tunnel || true

echo "Selesai: unit & skrip limit telah dipasang. Cek status service dengan:"
echo "  systemctl status limitvmess limitvless limittrojan limitshadowsocks vmip vlip trip"